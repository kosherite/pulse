<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork-only (pulse-staging): debug builds are the testing/staging app. The package is already
  com.pulse.whoop.debug (debug applicationIdSuffix), so it installs ALONGSIDE the official Pulse
  (com.pulse.whoop) with its own data. This override gives it a distinct launcher name so the two
  are tellable apart on the home screen. Build-type source set wins over main/flavor, so
  assembleFullDebug shows "Pulse Staging". Mirrors how the demo flavor labels itself "Pulse Demo".
-->
<resources>
    <string name="app_name">Pulse Staging</string>
</resources>
